% =====================================================================
%  CÁC TRANG ĐẦU: lời cam đoan, lời cảm ơn, tóm tắt
%  Giữ tên môi trường của mẫu gốc, đổi cách trình bày sang chuẩn DAU.
% =====================================================================
\newcommand{\dautrangdau}[1]{%
  \chapter*{#1}\addcontentsline{toc}{chapter}{#1}\markboth{#1}{}}

\newenvironment{declaration}{\dautrangdau{Lời cam đoan}}{}
\newenvironment{acknowledgments}{\dautrangdau{Lời cảm ơn}}{}
% Lớp book không định nghĩa sẵn abstract, nhưng vẫn dò trước cho chắc.
\@ifundefined{abstract}
  {\newenvironment{abstract}{\dautrangdau{Tóm tắt}}{}}
  {\renewenvironment{abstract}{\dautrangdau{Tóm tắt}}{}}

% Ô ký tên: #1 = họ tên in đậm dưới chỗ ký, #2 = chức danh in nghiêng ở trên
