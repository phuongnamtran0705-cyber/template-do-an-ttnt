% ---------- Listings, style DAU -------------------------------------
% Thay cho minted của bản gốc: listings không cần bật -shell-escape
% nên sinh viên build được ngay trên Overleaf lẫn máy cá nhân.
\lstdefinestyle{dau}{
  basicstyle=\ttfamily\small\color{daunavy},
  keywordstyle=\color{daumaroon}\bfseries,
  commentstyle=\color{gray500},
  stringstyle=\color{forestgreen},
  numbers=left, numberstyle=\tiny\color{gray500}, numbersep=8pt,
  showstringspaces=false, tabsize=2, breaklines=true, columns=fullflexible,
  frame=leftline, framerule=2.2pt, rulecolor=\color{daugold},
  backgroundcolor=\color{gray100}, xleftmargin=14pt, framexleftmargin=14pt,
  aboveskip=8pt, belowskip=6pt, lineskip=1pt, keepspaces=true,
}
\lstset{style=dau}
\renewcommand{\lstlistingname}{Mã nguồn}
\renewcommand{\lstlistlistingname}{Danh mục mã nguồn}

